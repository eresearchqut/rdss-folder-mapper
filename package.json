{
  "name": "rdss-folder-mapper-workspace",
  "private": true,
  "workspaces": [
    "cli",
    "gui"
  ],
  "scripts": {
    "build": "npm run build --workspace=cli && npm run build --workspace=gui",
    "dist": "npm run build && npm run dist --workspace=gui",
    "test": "npm run test --workspace=cli",
    "lint": "npm run lint --workspace=cli",
    "start:gui": "npm run build:ts --workspace=cli && npm run start --workspace=gui",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node docs/screenshots/capture.mjs && vitepress build docs",
    "docs:screenshots": "node docs/screenshots/capture.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "puppeteer": "^25.1.0",
    "vitepress": "^1.6.4"
  },
  "version": "1.9.2"
}
