    "@types/readline-sync": "^1.4.8",
    "@types/signale": "^1.4.7",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "adm-zip": "^0.5.17",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
