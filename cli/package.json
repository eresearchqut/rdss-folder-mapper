    "@stdlib/string-truncate": "^0.2.3",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "open": "^11.0.0",
    "readline-sync": "^1.4.10",
    "signale": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/commander": "^2.12.5",
    "@types/lodash": "^4.17.24",
